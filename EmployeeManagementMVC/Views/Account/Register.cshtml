@model EmployeeManagementMvc.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">
    <div class="auth-card card border-0 shadow-lg">
        <div class="card-body p-4 p-md-5">
            <div class="auth-heading text-center mb-4">
                <div class="auth-icon">EM</div>
                <h1 class="h3 fw-bold mb-2">Create your account</h1>
                <p class="text-muted mb-0">Join Employee Management today.</p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control form-control-lg" autocomplete="email" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control form-control-lg" autocomplete="new-password" placeholder="At least 8 characters" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" placeholder="Re-enter your password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">Create account</button>
            </form>

            <p class="text-center text-muted mt-4 mb-0">
                Already have an account?
                <a asp-controller="Account" asp-action="Login" class="fw-semibold text-decoration-none">Sign in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
