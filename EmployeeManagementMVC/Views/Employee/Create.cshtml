@model EmployeeManagementMvc.Models.Employee

@{
    ViewData["Title"] = "Add Employee";
}

<div class="form-shell">
    <div class="mb-4">
        <div class="eyebrow">People directory</div>
        <h1 class="page-title">Add employee</h1>
        <p class="page-description">Create a new employee profile for your organization.</p>
    </div>
    <section class="surface-card form-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-4"></div>
            <div class="mb-4"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="e.g. Jordan Smith" autocomplete="name" /><span asp-validation-for="Name" class="text-danger small"></span></div>
            <div class="mb-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" placeholder="name@company.com" autocomplete="email" /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <div class="mb-4"><label asp-for="Salary" class="form-label"></label><input asp-for="Salary" type="number" step="0.01" class="form-control" placeholder="0.00" /><div class="form-hint mt-1">Enter the annual salary in your local currency.</div><span asp-validation-for="Salary" class="text-danger small"></span></div>
            <div class="d-flex flex-column flex-sm-row gap-2 border-top pt-4"><button type="submit" class="btn btn-primary">Save employee</button><a asp-action="Index" class="btn btn-light border">Cancel</a></div>
        </form>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }